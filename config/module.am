# Automake silent rules
AM_V_LN   = $(AM_V_LN_@AM_V@)
AM_V_LN_  = $(AM_V_LN_@AM_DEFAULT_V@)
AM_V_LN_0 = echo "  LN      "
AM_V_LN_1 = true

module_links_stamp = $(localmoduledir)/.$(firstword $(module_LTLIBRARIES)).stamp
CLEANFILES         = $(module_links_stamp)

.PHONY: module-links

all-local: module-links

module-links: $(module_links_stamp)

# Create symbolic links for the built modules under $(localmoduledir)
# Link also *.la files to create proper makefile dependencies
$(module_links_stamp): $(module_LTLIBRARIES)
	$(AM_V_at)$(MKDIR_P) $(localmoduledir)
	$(AM_V_at)for lib in *.la $(objdir)/*$(shrext)*; do \
		(cd $(localmoduledir) && $(LN_RS) -nf $(shell pwd)/$$lib) || \
			exit $$?; \
	done
	@for lib in *.la $(objdir)/*$(shrext)*; do \
		$(AM_V_LN) $$lib; \
	done
	@touch $@
